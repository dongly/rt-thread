                status_icon = "✅" if result['is_compliant'] else "❌"
                relative_path = self.get_relative_path(result['function']['file'])
                
                if result['definition']:
                    modifiers = ["static"] if result['definition'].get('is_static', False) else []
                    modifier_str = " ".join(modifiers) + " " if modifiers else ""
                    signature = f"{modifier_str}{result['definition']['return_type']} {result['function']['function_name']}({result['definition']['parameters']})"
                else:
                    signature = f"找不到定义: {result['function']['function_name']}()"
                
                f.write(f"{status_icon} {signature}\n")
                f.write(f"  声明: {relative_path}:{result['function']['line_number']}\n")
                
                if result['definition']:
                    f.write(f"  定义: {relative_path}:{result['definition']['line_number']}\n")
                else:
                    f.write(f"  定义: 未找到\n")
                
                if not result['is_compliant'] and result['issues']:
                    f.write("  问题:\n")
                    for issue in result['issues']:
                        f.write(f"    - {issue}\n")
                
                f.write("\n")

if __name__ == "__main__":
